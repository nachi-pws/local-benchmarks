{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "noEmit": true
  },
  "include": ["scripts/**/*.js", "docs/**/*.js", "read-gguf-properties.js", "report-generator.js", "run-all-benchmarks.js", "analyze-model-quality.js", "compare-all-models-next.js"],
  "exclude": ["node_modules", "dist", "archives"]
}
